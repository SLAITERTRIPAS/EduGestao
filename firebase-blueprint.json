{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "System user with role-based access",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "schoolId": { "type": "string" },
        "password": { "type": "string" },
        "trainingArea": { "type": "string" },
        "subject": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Employee": {
      "title": "Employee Profile",
      "description": "School staff member (Docente or CTA)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "career": { "type": "string" },
        "nuit": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "taughtSubjects": { "type": "array", "items": { "type": "string" } },
        "assignedClasses": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "schoolId", "name", "career"]
    },
    "Class": {
      "title": "Class",
      "description": "School class / Turma",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "year": { "type": "number" },
        "period": { "type": "string" }
      },
      "required": ["id", "schoolId", "name", "gradeLevel", "year"]
    },
    "Student": {
      "title": "Student Profile",
      "description": "Student record including enrollment history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "name": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "classId": { "type": "string" },
        "status": { "type": "string" },
        "enrollmentHistory": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["id", "schoolId", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of system users"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Collection of school employees"
    },
    "/classes/{classId}": {
      "schema": "Class",
      "description": "Collection of school classes"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of students"
    },
    "/examGrades/{gradeId}": {
      "schema": "object",
      "description": "Final exam grades"
    },
    "/collectionPeriods/{periodId}": {
      "schema": "object",
      "description": "Data collection windows"
    },
    "/collectionForms/{formId}": {
      "schema": "object",
      "description": "Submitted collection data"
    },
    "/chatMessages/{messageId}": {
      "schema": "object",
      "description": "Official communication log"
    }
  }
}
