rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helpers
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return isVerified() && (request.auth.token.email == 'slaitertripas@gmail.com' || exists(/databases/$(database)/documents/admins/$(request.auth.uid))); }

    // Collection: Users
    match /users/{userId} {
      function isValidUser(data) {
        return data.id is string && data.id.size() <= 128 &&
               data.name is string && data.name.size() <= 200 &&
               data.email is string && data.email.size() <= 200 &&
               data.role is string;
      }
      allow get: if isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && resource.data.schoolId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId);
      allow create: if isSignedIn() && isValidUser(incoming()) && (isAdmin() || request.auth.uid == userId);
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        isAdmin() || 
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'trainingArea', 'subject', 'password']))
      );
      allow delete: if isAdmin();
    }

    // Collection: Employees
    match /employees/{employeeId} {
      function isValidEmployee(data) {
        return data.id is string && data.schoolId is string &&
               data.name is string && data.name.size() <= 200 &&
               data.career is string;
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidEmployee(incoming()) && (isAdmin() || incoming().schoolId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId);
      allow update: if isSignedIn() && isValidEmployee(incoming()) && (isAdmin() || existing().schoolId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId);
      allow delete: if isAdmin();
    }

    // Collection: Classes
    match /classes/{classId} {
      function isValidClass(data) {
        return data.id is string && data.schoolId is string &&
               data.name is string && data.gradeLevel is string;
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidClass(incoming()) && (isAdmin() || incoming().schoolId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId);
      allow update: if isSignedIn() && isValidClass(incoming()) && (isAdmin() || existing().schoolId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId);
      allow delete: if isAdmin();
    }

    // Collection: Students
    match /students/{studentId} {
      function isValidStudent(data) {
        return data.id is string && data.schoolId is string &&
               data.name is string && data.name.size() <= 200;
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidStudent(incoming()) && (isAdmin() || incoming().schoolId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId);
      allow update: if isSignedIn() && isValidStudent(incoming()) && (isAdmin() || existing().schoolId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId);
      allow delete: if isAdmin();
    }
    
    // Supporting Collections (Auto-synced in store)
    match /evaluations/{id} { allow read, write: if isSignedIn(); }
    match /classTasks/{id} { allow read, write: if isSignedIn(); }
    match /schools/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /schoolDocuments/{id} { allow read, write: if isSignedIn(); }
    match /notifications/{id} { allow read, write: if isSignedIn(); }
    match /subjects/{id} { allow read, write: if isSignedIn(); }
    match /grades/{id} { allow read, write: if isSignedIn(); }
    match /examGrades/{id} { allow read, write: if isSignedIn(); }
    match /collectionPeriods/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /collectionForms/{id} { allow read, write: if isSignedIn(); }
    match /chatMessages/{id} { allow read, write: if isSignedIn(); }
    match /backups/{id} { allow read, write: if isAdmin(); }
  }
}
